# Supabase Configuration
# Runtime keys (Service Role for backend operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ROLE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VOXFLAME_PUBLIC_BASE_URL=https://voxember.com
VOXFLAME_COLLECTION_PUBLIC_BASE_URL=
VOXFLAME_ALLOWED_ORIGINS=https://voxember.com

# Supabase Phone Auth -> Tencent Cloud SMS (server-only)
# Keep both safety switches disabled until the signed hook dry-run succeeds.
PHONE_AUTH_ENABLED=0
TENCENT_SMS_DRY_RUN=1
SUPABASE_SEND_SMS_HOOK_SECRET=
TENCENTCLOUD_SECRET_ID=your-tencent-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencent-secret-key
TENCENT_SMS_SDK_APP_ID=your-sms-sdk-app-id
TENCENT_SMS_SIGN_NAME=your-approved-sign-name
TENCENT_SMS_TEMPLATE_ID=your-approved-template-id
TENCENT_SMS_REGION=ap-guangzhou

# Aliyun OSS Configuration
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=voxflame
OSS_REGION=oss-cn-shanghai

# LiveKit Configuration
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=voxflame-agent
LIVEKIT_AGENT_HEALTH_URL=http://livekit-agent:8081/
LIVEKIT_AGENT_HEALTH_TIMEOUT_MS=2000

# VolcEngine API Configuration (ASR)
VOLCENGINE_ACCESS_KEY_ID=your-volc-id
VOLCENGINE_SECRET_ACCESS_KEY=your-volc-secret
VOLCENGINE_APP_ID=your-volc-app-id
VOLCENGINE_TOKEN=your-volc-token

# Alibaba Cloud API Configuration (ASR)
ALIBABA_APP_KEY=your-ali-app-key
ALIBABA_ACCESS_KEY_ID=your-ali-id
ALIBABA_ACCESS_KEY_SECRET=your-ali-secret
\n# Redis Configuration\nREDIS_HOST=redis\nREDIS_PORT=6379\nREDIS_PASSWORD=voxflame_redis_secret
