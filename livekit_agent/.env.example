# LiveKit 连接（第一阶段最重要）
# 这些不是“依赖服务商”的凭据，而是你自部署 LiveKit server 自己生成/持有的连接信息。
# 本地开发如果使用 `livekit-server --dev`，官方默认就是：
#   LIVEKIT_URL=ws://127.0.0.1:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=voxflame_livekit_dev_secret_32chars
# 生产环境则换成你自己的域名、TLS 和密钥。
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=voxflame_livekit_dev_secret_32chars
LIVEKIT_AGENT_NAME=voxflame-agent

# 模型提供方
# 现役 VoxFlame 执行面仍是 DashScope / Qwen-first。
OPENAI_API_KEY=

# 与现役执行面语言对齐的 ASR/TTS provider 配置。
DASHSCOPE_API_KEY=
# 沟通页 correction / rewrite 专用模型。
# 这是实时链路，默认优先小模型、低时延。
DASHSCOPE_CORRECTION_MODEL=qwen-flash
# 兼容旧配置位；未设置 correction model 时才会回退到这里。
DASHSCOPE_LLM_MODEL=qwen-flash
DASHSCOPE_TIMEOUT_SECONDS=15
# 沟通页 correction/rewrite 的硬取消时限；HTTP 自身超时也仍生效，
# 不再把超时后的原始 ASR 伪装成最终 correction。
DASHSCOPE_REPLY_TIMEOUT_SECONDS=4.5
# correction 现在默认按“小型 formatter”思路跑：
# - 非思考模式
# - 很小的输出上限
# - 不依赖 prompt/session cache，避免缓存过期带来的上下文不一致
DASHSCOPE_LLM_TEMPERATURE=0.1
DASHSCOPE_LLM_MAX_TOKENS=32
DASHSCOPE_SESSION_CACHE_ENABLED=0
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_REALTIME_LANGUAGE=zh
# LiveKit Python RTC AudioProcessingModule（第一片）
# 这是 agent 端在收到房间麦克风音频后做的保守处理。
# 当前默认：
# - 开启 noise suppression / high-pass filter
# - 关闭 echo cancellation / auto gain control
# 因为当前处理的是远端订阅音频，不是本地全双工采集；对构音障碍场景也先避免过激增益。
LIVEKIT_AUDIO_APM_ENABLED=1
# 无对齐播放参考，设置为 1 会明确拒绝启动音频链，不会伪装 AEC 生效。
LIVEKIT_AUDIO_APM_ECHO_CANCELLATION=0
LIVEKIT_AUDIO_APM_NOISE_SUPPRESSION=1
LIVEKIT_AUDIO_APM_HIGH_PASS_FILTER=1
LIVEKIT_AUDIO_APM_AUTO_GAIN_CONTROL=0
# 无已验证端侧 AEC 的自动播报场景默认半双工；full 只用于已验证的设备组。
# 这是部署配置，不接受客户端 metadata 自行覆盖。
VOXFLAME_AUDIO_DUPLEX_MODE=half
# 服务端播放结束后的保护时间，不是设备播放完成 ACK；真机测量后调整。
VOXFLAME_AUDIO_PLAYOUT_TAIL_SECONDS=0.3
QWEN_ASR_VAD_THRESHOLD=0.018
QWEN_ASR_VAD_SILENCE_DURATION_MS=720
# 用户重新开口持续到这个时长后，才真正触发 barge-in 打断当前 TTS。
# 这是给构音障碍用户留的缓冲，避免短促噪声/咳嗽就直接抢断。
QWEN_ASR_BARGE_IN_MIN_SPEECH_MS=220
QWEN_TTS_REALTIME_MODEL=qwen3-tts-flash-realtime
 # Optional Alibaba Cloud Model Studio/CosyVoice model override
DASHSCOPE_TTS_MODEL=
ALIYUN_TTS_MODEL=
QWEN_TTS_REALTIME_VOICE=Cherry

# 日志级别（与 ten_agent 对齐）
LOG_LEVEL=info

# Optional metadata used by the worker for local debugging.
VOXFLAME_LIVEKIT_AGENT_MODE=communication_stub

# Worker 派单保护。当前 docker-compose 的 2 GiB Agent 容器默认只接 2 个活跃 Job。
# 新增 Agent Worker 才是提高总并发的主路径；上调单机值前先压测 CPU、内存和 provider 配额。
VOXFLAME_AGENT_MAX_ACTIVE_JOBS=2
VOXFLAME_AGENT_LOAD_THRESHOLD=0.7
VOXFLAME_AGENT_MEMORY_PRESSURE_PERCENT=85
VOXFLAME_AGENT_DRAIN_TIMEOUT_SECONDS=1800
VOXFLAME_AGENT_IDLE_PROCESSES=2
VOXFLAME_AGENT_JOB_MEMORY_WARN_MB=450
VOXFLAME_AGENT_JOB_MEMORY_LIMIT_MB=700

# 同一 Agent 容器内跨 Job 进程共享的 ASR/LLM/TTS 槽位。
# 该文件锁方案不跨服务器；多 Worker 服务器需要集中式集群总配额。
VOXFLAME_PROVIDER_CAPACITY_DIRECTORY=/tmp/voxflame-provider-capacity
VOXFLAME_PROVIDER_ASR_MAX_CONCURRENCY=2
VOXFLAME_PROVIDER_ASR_WAIT_TIMEOUT_SECONDS=0.25
VOXFLAME_PROVIDER_LLM_MAX_CONCURRENCY=2
VOXFLAME_PROVIDER_LLM_WAIT_TIMEOUT_SECONDS=0.25
VOXFLAME_PROVIDER_TTS_MAX_CONCURRENCY=2
VOXFLAME_PROVIDER_TTS_WAIT_TIMEOUT_SECONDS=0.25
