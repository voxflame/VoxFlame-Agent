FROM docker.m.daocloud.io/library/python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/voxflame-site-packages

WORKDIR /app

COPY .venv/lib/python3.10/site-packages /opt/voxflame-site-packages

RUN python -c "import livekit; import livekit.agents; import websockets; import dotenv"

COPY *.py /app/
COPY scripts /app/scripts

# Import the real entrypoint without credentials or a running LiveKit server.
RUN PYTHON_DOTENV_DISABLED=1 LIVEKIT_URL=ws://127.0.0.1:7880 \
    LIVEKIT_API_KEY=build-check LIVEKIT_API_SECRET=build-check-not-a-real-secret \
    python -c "import app"

CMD ["python", "app.py", "start"]
