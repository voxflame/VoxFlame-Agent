# Android 真机不能访问电脑的 127.0.0.1；请换成电脑局域网 IP。
# 示例：EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3001/api
EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:3001/api
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
EXPO_PUBLIC_PHONE_AUTH_ENABLED=0

# 产品展示名与主色。主 App 可留空并使用 app.json；第二品牌构建必须显式填写。
EXPO_PUBLIC_APP_BRAND_NAME=
EXPO_PUBLIC_APP_BRAND_ACCENT=#C65D2E
