# ============================================
# VoxFlame-Agent Unified Environment Configuration
# ============================================

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Backend Database Connection (Optional if using Supabase client only)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Aliyun OSS Configuration ---
OSS_ACCESS_KEY_ID=your-oss-id
OSS_ACCESS_KEY_SECRET=your-oss-secret
OSS_BUCKET=voxflame
OSS_REGION=oss-cn-shanghai

# --- Backend Configuration ---
PORT=3001
BACKEND_PORT=3001
NODE_ENV=production
VOXFLAME_ALLOWED_ORIGINS=https://voxember.com
VOXFLAME_COLLECTION_PUBLIC_BASE_URL=
VOXFLAME_JSON_BODY_LIMIT=1mb
VOXFLAME_WEBHOOK_CONVERSATION_ENABLED=0
VOXFLAME_WEBHOOK_CONVERSATION_SECRET=

# --- Supabase Phone Auth -> Tencent Cloud SMS (Backend only) ---
# Production rollout starts with PHONE_AUTH_ENABLED=0 and TENCENT_SMS_DRY_RUN=1.
PHONE_AUTH_ENABLED=0
TENCENT_SMS_DRY_RUN=1
SUPABASE_SEND_SMS_HOOK_SECRET=
TENCENTCLOUD_SECRET_ID=your-tencent-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencent-secret-key
TENCENT_SMS_SDK_APP_ID=your-sms-sdk-app-id
TENCENT_SMS_SIGN_NAME=your-approved-sign-name
TENCENT_SMS_TEMPLATE_ID=your-approved-template-id
TENCENT_SMS_REGION=ap-guangzhou

# --- Frontend Local Development ---
# 浏览器直接访问本机 backend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_PHONE_AUTH_ENABLED=0

# --- Frontend Docker Deployment ---
# docker-compose 会把它传给前端 build args，生产环境推荐固定为 /api
FRONTEND_NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ICP_BEIAN_NUMBER=沪ICP备2026020229号
NEXT_PUBLIC_ICP_BEIAN_URL=https://beian.miit.gov.cn/
NEXT_PUBLIC_ICP_BEIAN_COMPANY_NAME=上海生声不息科技有限公司
NEXT_PUBLIC_ANDROID_APP_DOWNLOAD_URL=https://voxember.com/download/android
NEXT_PUBLIC_IOS_APP_DOWNLOAD_URL=
BACKEND_INTERNAL_URL=http://backend:3001
VOXFLAME_PUBLIC_BASE_URL=https://voxember.com
VOXFLAME_PUBLIC_HOST=voxember.com
VOXFLAME_COLLECTION_SITE_ADDRESS=http://127.0.0.1

# 第二品牌站（独立前端构建，共用 Backend/Auth/OSS/数据契约）
# 产品页面不显示“燃言 / VoxFlame”；法定运营主体与备案信息必须保持真实。
NEXT_PUBLIC_VOXFLAME_COLLECTION_BRAND_NAME=科菲
NEXT_PUBLIC_VOXFLAME_COLLECTION_BRAND_ENGLISH_NAME=
NEXT_PUBLIC_VOXFLAME_COLLECTION_BRAND_TAGLINE=让每一种表达，都有被听见的机会
NEXT_PUBLIC_VOXFLAME_COLLECTION_BRAND_LOGO_URL=/brands/kofei.svg
NEXT_PUBLIC_VOXFLAME_COLLECTION_BRAND_ACCENT=#176B61
# 必须指向第二品牌自己的安装包/商店页面；留空时页面显示“准备中”。
# 不得填写主站 VoxFlame APK，避免安装后暴露原产品品牌。
NEXT_PUBLIC_VOXFLAME_COLLECTION_ANDROID_APP_DOWNLOAD_URL=
NEXT_PUBLIC_VOXFLAME_COLLECTION_IOS_APP_DOWNLOAD_URL=
VOXFLAME_ENABLE_PWA=1
# 本地 `npm run dev` 如需真的保留 service worker / install prompt，再显式打开
VOXFLAME_ENABLE_PWA_DEV=0

# --- LiveKit RTC / Agent Configuration ---
# 本机直接开发时可用 ws://127.0.0.1:7880
# docker-compose 内部默认可用 ws://livekit-server:7880
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_BROWSER_URL=wss://voxember.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=voxflame_livekit_dev_secret_32chars
LIVEKIT_DOCKER_URL=ws://livekit-server:7880
LIVEKIT_SERVER_IMAGE=docker.m.daocloud.io/livekit/livekit-server:v1.13.6
LIVEKIT_CONFIG_FILE=./infra/livekit/livekit.dev.yaml
LIVEKIT_SERVER_DEV_MODE=1
VOXFLAME_LIVEKIT_TURN_UDP_PORT=443
VOXFLAME_LIVEKIT_TURN_TLS_PORT=5349
VOXFLAME_LIVEKIT_TURN_TLS_ENABLED=0
VOXFLAME_LIVEKIT_TURN_DOMAIN=
LIVEKIT_AGENT_NAME=voxflame-agent
LIVEKIT_AGENT_LOG_LEVEL=info
LIVEKIT_SIGNAL_PROXY_TARGET=http://livekit-server:7880
NEXT_PUBLIC_RTC_EXECUTION_BACKEND=livekit
# 当前 Compose 给 Agent 容器 2 GiB；8 路静默 Job 已通过，CPU/内存准入仍可提前拒绝新房间。
VOXFLAME_AGENT_MAX_ACTIVE_JOBS=8
VOXFLAME_AGENT_LOAD_THRESHOLD=0.7
VOXFLAME_AGENT_MEMORY_PRESSURE_PERCENT=85
VOXFLAME_AGENT_DRAIN_TIMEOUT_SECONDS=1800
VOXFLAME_AGENT_IDLE_PROCESSES=2
VOXFLAME_AGENT_JOB_MEMORY_WARN_MB=450
VOXFLAME_AGENT_JOB_MEMORY_LIMIT_MB=700
# 这些槽位在同一 Agent 容器的独立 Job 进程间共享。多服务器总配额仍需 Redis/集中配额层。
VOXFLAME_PROVIDER_CAPACITY_DIRECTORY=/tmp/voxflame-provider-capacity
VOXFLAME_PROVIDER_ASR_MAX_CONCURRENCY=4
VOXFLAME_PROVIDER_ASR_WAIT_TIMEOUT_SECONDS=0.25
# 个性化 HTTP ASR 满载或失败时使用独立 realtime fallback 槽池，避免被主槽池一起锁死。
VOXFLAME_PROVIDER_ASR_FALLBACK_MAX_CONCURRENCY=4
VOXFLAME_PROVIDER_ASR_FALLBACK_WAIT_TIMEOUT_SECONDS=0.25
VOXFLAME_PROVIDER_LLM_MAX_CONCURRENCY=8
VOXFLAME_PROVIDER_LLM_WAIT_TIMEOUT_SECONDS=0.25
# 当前 DashScope TTS 直连实测 3 路稳定，4 路会限流；额外请求允许短暂排队。
VOXFLAME_PROVIDER_TTS_MAX_CONCURRENCY=3
VOXFLAME_PROVIDER_TTS_WAIT_TIMEOUT_SECONDS=3

# --- DashScope / Qwen Models ---
# Compose 的 Backend/Agent 共用本文件中的 Key 和接入地址；密钥不得提交。
# 专属业务空间：HTTPS 使用 /compatible-mode/v1，实时语音使用 WSS /api-ws/v1/realtime。
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 沟通页实时 correction / rewrite
DASHSCOPE_CORRECTION_MODEL=qwen-flash
DASHSCOPE_LLM_MODEL=qwen3.6-plus
# 记忆系统后台维护：只更新 4 块长期记忆，不新增新的长期对象
DASHSCOPE_MEMORY_MAINTENANCE_MODEL=qwen3.5-plus
DASHSCOPE_MEMORY_MAINTENANCE_TIMEOUT_SECONDS=12
# 训练页每日总结 / 7 天总结
DASHSCOPE_TRAINING_REPORT_MODEL=qwen3.5-plus
DASHSCOPE_TRAINING_REPORT_TIMEOUT_SECONDS=12
QWEN_ASR_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime-2026-02-10
QWEN_ASR_VAD_THRESHOLD=0.032
QWEN_ASR_VAD_SILENCE_DURATION_MS=860
QWEN_ASR_BARGE_IN_MIN_SPEECH_MS=360
QWEN_ASR_MIN_COMMIT_SPEECH_MS=420
# 所有已认证账号的沟通页 / 训练评测页统一走 HTTP multipart ASR；模型服务按 X-Account-ID
# 选择个性化模型，未注册账号由模型服务使用公共 fallback。新增用户模型不需要修改 VoxFlame 配置。
# HTTP ASR 不可用时 livekit_agent 会回退 QWEN_ASR_REALTIME_*。
# livekit_agent 默认使用 host network，因此容器内 127.0.0.1 就是 cpu1 宿主机。
# 如果改回 Docker bridge 网络，需要把地址改为宿主机可监听的 host.docker.internal 或宿主机内网 IP。
QWEN_HTTP_ASR_URL=http://127.0.0.1:8001/transcribe
QWEN_HTTP_ASR_LANGUAGE=Chinese
# 个性化 HTTP ASR 超过实时等待预算后尽快切换到 DashScope realtime fallback。
QWEN_HTTP_ASR_TIMEOUT_SECONDS=5
QWEN_TTS_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_TTS_REALTIME_MODEL=qwen3-tts-flash-realtime
 # Optional Alibaba Cloud Model Studio/CosyVoice model override (for example: cosyvoice-v3-flash)
DASHSCOPE_TTS_MODEL=
ALIYUN_TTS_MODEL=

# --- ASR Services (Optional) ---
# VolcEngine
VOLCENGINE_ACCESS_KEY_ID=...
VOLCENGINE_SECRET_ACCESS_KEY=...
# Alibaba
ALIBABA_APP_KEY=...
ALIBABA_ACCESS_KEY_ID=...

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=voxflame_redis_secret
