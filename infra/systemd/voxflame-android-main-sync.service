[Unit]
Description=VoxFlame Android origin/main release sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=voxflame-android-build
Group=voxflame-android-build
Environment=HOME=/var/lib/voxflame-android-build
Environment=XDG_CONFIG_HOME=/var/lib/voxflame-android-build/config
StateDirectory=voxflame-android-build
StateDirectoryMode=0750
# EAS CLI writes its own state beside the read-only Expo token. Ensure a
# manually provisioned config directory remains writable by the build user.
ExecStartPre=+/usr/bin/install -d -m 0750 -o voxflame-android-build -g voxflame-android-build /var/lib/voxflame-android-build/config
ExecStart=/usr/local/libexec/voxflame-android-main-sync
TimeoutStartSec=45min
MemoryHigh=2G
MemoryMax=3G
TasksMax=512
CPUQuota=200%
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voxflame-android-build
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
